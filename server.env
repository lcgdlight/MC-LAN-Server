# ============================================================
# MC-LAN-Server 配置文件
# 修改后保存，下次双击 start.bat 生效。
# 这里只放需要经常改的项；其他 server.properties 项会保留。
# 注意：不要用记事本另存为 ANSI，保持 UTF-8 即可。
# ============================================================

# 客户端与服务端必须完全一致。PCL2 里也要安装这个版本。
MC_VERSION=26.3

# 服务端 jar 文件名。用 download-server.bat 下载后保持 server.jar 即可。
SERVER_JAR=fabric-server-launch.jar

# 固定局域网端口。朋友连接地址为：你的IPv4:25565
SERVER_PORT=25565

# 正版验证：
#   false = 离线模式，没有正版账号的朋友也能进（默认，仅建议可信局域网）
#   true  = 正版模式，必须使用微软正版账号登录
ONLINE_MODE=false

# 服务器列表里显示的欢迎语。支持中文，脚本会自动做 Unicode 转义。
# 支持 § 颜色符号，例如：§a生存服 §7| §e欢迎
MOTD=§aFabric LAN Server §7| §eMinecraft 26.3

# 最大人数、视距、模拟距离
MAX_PLAYERS=10
VIEW_DISTANCE=10
SIMULATION_DISTANCE=10

# 出生点保护半径（0 = 关闭保护，方便在出生点建造）
SPAWN_PROTECTION=0

# 难度：peaceful / easy / normal / hard
DIFFICULTY=normal

# 默认游戏模式：survival / creative / adventure / spectator
GAMEMODE=survival

# PVP 与白名单
PVP=true
WHITELIST=false

# 内存。默认 2G 起步、4G 上限；16G 内存机器可保持默认。
# 格式：1024M、2G、4G。MAX_MEMORY 不要超过物理内存的 80%。
MIN_MEMORY=2G
MAX_MEMORY=4G

# 额外 JVM 参数（可选，默认留空）。会追加到脚本内置的 Aikar GC 参数之后。
# 多个参数用空格分隔；参数值含空格时用英文双引号，双引号要写在等号后面。
# 示例：JVM_ARGS=-Dcustom.name="My LAN Server" -XX:+UseStringDeduplication
# 不要填写 -jar、-cp、-classpath；主类和 classpath 由启动脚本管理。
JVM_ARGS=

# Java 路径。留空 = 自动检测（推荐）。
# 自动检测失败时，填完整路径，例如：C:\Program Files\Java\jdk-25\bin\java.exe
JAVA_EXE=

# RCON 管理端口（服务器默认监听所有网卡；防火墙会阻断外部访问，stop.bat/admin.bat 通过本机 127.0.0.1 连接）
RCON_PORT=25575
